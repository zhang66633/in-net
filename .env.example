# in-net configuration — copy to .env or set as environment variables
# CLI flags take precedence over env vars.

# Listen port (default: 8787)
IN_NET_PORT=8787

# Upstream OpenAI-compatible API endpoint (fallback if no runtime config)
IN_NET_UPSTREAM=https://your-upstream-url/v1/chat/completions

# Default API key (fallback — management UI has full key management)
IN_NET_API_KEY=

# Enable debug logging
IN_NET_DEBUG=false

# Max retry attempts on transient upstream errors (default: 3, max: 10)
IN_NET_RETRY=3

# Data directory for persistent storage (default: ~/.in-net)
IN_NET_DATA_DIR=

# Admin panel password (auto-generated if not set, printed on first startup)
IN_NET_ADMIN_PASSWORD=
